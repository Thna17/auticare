NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://auticare:auticare_dev_password@localhost:3308/auticare
SHADOW_DATABASE_URL=mysql://root:auticare_root_dev_password@localhost:3308/auticare_shadow
APP_ORIGIN=http://localhost:4200
API_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=
LOG_LEVEL=debug
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AutiCare <no-reply@example.com>
# AI assistant (optional). Any OpenAI-compatible chat-completions endpoint.
# Leave both unset and the assistant reports itself as unconfigured while the
# rest of the app keeps working. AI_BASE_URL and AI_MODEL must be set together.
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=
# AI_MODEL=your-model-name
# AI_TIMEOUT_MS=20000
# AI_TEMPERATURE=0.3
# AI_MAX_DAILY_MESSAGES=40

MYSQL_DATABASE=auticare
MYSQL_USER=auticare
MYSQL_PASSWORD=auticare_dev_password
MYSQL_ROOT_PASSWORD=auticare_root_dev_password
