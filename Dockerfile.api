# ------------------------------------------------------------------------------
# Production Dockerfile for @auticare/api
# Multi-stage build: builder -> pruned deploy -> secure unprivileged runtime
# ------------------------------------------------------------------------------

FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@9.15.1 --activate

# Copy monorepo manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/contracts/package.json ./packages/contracts/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Install dependencies (frozen lockfile)
RUN pnpm install --frozen-lockfile

# Copy source code and Prisma schema
COPY packages/contracts ./packages/contracts
COPY apps/api ./apps/api

# Build contracts and compile API TypeScript
RUN pnpm --filter @auticare/contracts build
RUN pnpm --filter @auticare/api db:generate
RUN pnpm --filter @auticare/api build

# Prune to isolated production deployment
RUN pnpm --filter @auticare/api --prod deploy /app/deployed-api

# ------------------------------------------------------------------------------
# Runtime stage
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runner

WORKDIR /app

# Install dumb-init, openssl (for Prisma engines), curl (for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    dumb-init \
    openssl \
    curl \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Enable pnpm in runner stage for migration-runner execution
RUN corepack enable && corepack prepare pnpm@9.15.1 --activate

ENV NODE_ENV=production
ENV PORT=3000
ENV PATH="/app/node_modules/.bin:${PATH}"

# Copy pruned production application (includes prisma CLI and engines from dependencies)
COPY --chown=node:node --from=builder /app/deployed-api /app
# Copy built contracts dist into node_modules
COPY --chown=node:node --from=builder /app/packages/contracts/dist /app/node_modules/@auticare/contracts/dist
# Copy generated Prisma schema and client
COPY --chown=node:node --from=builder /app/apps/api/prisma /app/prisma
# Copy compiled API dist
COPY --chown=node:node --from=builder /app/apps/api/dist /app/dist
# Copy workspace manifest for pnpm --filter compatibility
COPY --chown=node:node pnpm-workspace.yaml /app/pnpm-workspace.yaml

# Create uploads storage directory with non-root ownership
RUN mkdir -p /app/storage/uploads && chown -R node:node /app/storage

USER node

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3000/health/live || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "dist/server.js"]
