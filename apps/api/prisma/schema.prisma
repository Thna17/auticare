generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  PARENT
  ADMIN
  SCHOOL
  HOSPITAL
}

enum ScreeningStatus {
  DRAFT
  SUBMITTED
  ANALYZED
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
}

// Direction of a screening question relative to autism-likelihood risk.
// DIRECT  = a higher raw answer value (closer to "Always") indicates HIGHER risk
//           (e.g. sensory sensitivity / repetitive behaviour items).
// REVERSE = a higher raw answer value indicates LOWER risk
//           (e.g. social / communication / play skill items, where doing the
//            healthy behaviour "Always" is a good sign).
enum QuestionPolarity {
  DIRECT
  REVERSE
}

// Age band a screening question belongs to. Sessions are served only the questions
// matching the child's age at session-creation time (under 4 => TODDLER, 4+ =>
// PRESCHOOL). See ageBand on ScreeningQuestion and (Phase 3) on Screening.
enum AgeBand {
  TODDLER
  PRESCHOOL
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  SYSTEM
  APPOINTMENT
  ADMISSION
  SCREENING
  ACTIVITY
  SCHOOL_REPORT
  ENROLLMENT_REQUEST
  REPORT_REQUEST
}

enum SchoolEnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
  GRADUATED
  ENDED
}

enum AdmissionRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum ActivityReportStatus {
  DRAFT
  SUBMITTED
}

enum SchoolRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HospitalRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Which question set a screening belongs to. FULL is the long instrument that
// already exists (46 items per age band). SHORT is the handful of threshold
// questions a parent meets straight after login, before the app opens. Both are
// scored by the same engine, so their results stay comparable.
enum ScreeningFormKind {
  FULL
  SHORT
}

// What a parent recorded happening. Deliberately plain and observable — these
// are things a caregiver can see, not clinical constructs.
enum ObservationCategory {
  CRYING
  SLEEP
  EATING
  SENSORY
  SOCIAL
  ROUTINE
  OTHER
}

enum AiMessageRole {
  USER
  ASSISTANT
}

// What kind of turn this was. CRISIS and MEDICATION are refusals produced by the
// safety layer without calling a model at all, so a reviewer can tell an
// AI-written answer from a fixed one. Stored rather than recomputed because the
// classification is a fact about the moment the parent asked.
enum AiMessageKind {
  ANSWER
  CRISIS
  MEDICATION
}

model Parent {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  // Login name for accounts a school creates without an email (teachers).
  // Such accounts get an undeliverable `@staff.auticare.invalid` email.
  username                String?                  @unique
  passwordHash            String
  firstName               String
  lastName                String
  phoneNumber             String?
  socialMediaAccount      String?
  role                    UserRole                 @default(PARENT)
  mustResetPassword       Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  preference              ParentPreference?
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  invitations             AccountInvitation[]
  children                Child[]
  favoriteSchools         FavoriteSchool[]
  reviews                 Review[]
  admissionRequests       AdmissionRequest[]
  appointments            Appointment[]
  notifications           Notification[]
  schoolStaffProfiles     SchoolStaff[]
  activityReports         ActivityReport[]
  hospitalStaffProfiles   HospitalStaff[]
  reportAttachmentUploads ReportAttachmentUpload[]
  observations            BehaviorObservation[]
  aiConversations         AiConversation[]
  subscriptions           Subscription[]
  sponsorships            Sponsorship[]

  @@index([email])
}

model RefreshToken {
  id                String         @id @default(cuid())
  parentId          String
  tokenHash         String         @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime       @default(now())
  parent            Parent         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  replacedByToken   RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id])
  replacedTokens    RefreshToken[] @relation("RefreshTokenRotation")

  @@index([parentId])
  @@index([replacedByTokenId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  parentId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  parent    Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model ParentPreference {
  id                String   @id @default(cuid())
  parentId          String   @unique
  preferredLanguage String   @default("en")
  reducedMotion     Boolean  @default(false)
  highContrast      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  parent            Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model Child {
  id                String                  @id @default(cuid())
  parentId          String
  firstName         String
  lastName          String?
  dateOfBirth       DateTime
  photoUrl          String?
  address           String?                 @db.Text
  notes             String?                 @db.Text
  archivedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  parent            Parent                  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  screenings        Screening[]
  appointments      Appointment[]
  activityProgress  ActivityProgress[]
  schoolEnrollments SchoolChildEnrollment[]
  activityReports   ActivityReport[]
  admissionRequests AdmissionRequest[]
  observations      BehaviorObservation[]
  aiConversations   AiConversation[]
  aiInsights        AiInsight[]

  @@index([parentId, archivedAt])
}

model ScreeningQuestion {
  id           String            @id @default(cuid())
  questionText String
  // Free-form category label, e.g. "Social Interaction", "Play & Imagination",
  // "Flexibility & Routine". No enum constraint — the toddler and preschool bands
  // use overlapping-but-different category sets.
  category     String
  displayOrder Int
  polarity     QuestionPolarity  @default(REVERSE)
  ageBand      AgeBand           @default(TODDLER)
  // FULL = the long instrument. SHORT = the threshold questions used by the
  // post-login assessment. A session is served only one kind.
  formKind     ScreeningFormKind @default(FULL)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  answers      ScreeningAnswer[]

  @@index([isActive, displayOrder])
  @@index([ageBand, formKind, isActive, displayOrder])
}

model Screening {
  id          String            @id @default(cuid())
  childId     String
  status      ScreeningStatus   @default(DRAFT)
  // Age band chosen from the child's age at session-creation time. Frozen here so
  // later scoring/history stays correct even if the child ages into another band.
  // Nullable for sessions created before age banding existed.
  ageBand     AgeBand?
  // Frozen at creation so a session is scored against, and resumed with, the
  // question set it was started with.
  formKind    ScreeningFormKind @default(FULL)
  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  child       Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  answers     ScreeningAnswer[]
  result      ScreeningResult?

  @@index([childId, status])
}

model ScreeningAnswer {
  id          String            @id @default(cuid())
  screeningId String
  questionId  String
  answerValue Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  screening   Screening         @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  question    ScreeningQuestion @relation(fields: [questionId], references: [id])

  @@unique([screeningId, questionId])
}

model ScreeningResult {
  id              String                   @id @default(cuid())
  screeningId     String                   @unique
  score           Int
  // Normalized 0-100 risk indicator (polarity-corrected). Nullable so pre-v2
  // results scored by the old raw-sum engine remain valid without a misleading
  // backfilled value.
  riskPercentage  Int?
  riskLevel       RiskLevel
  recommendation  String                   @db.Text
  disclaimer      String                   @db.Text
  analysisVersion String
  analyzedAt      DateTime                 @default(now())
  screening       Screening                @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  categoryScores  ScreeningCategoryScore[]
}

// Per-category (polarity-corrected) risk breakdown for a completed screening.
// Stored as a related table (matching the schema's convention for nested data)
// so history/comparison can read a session's category profile.
model ScreeningCategoryScore {
  id             String          @id @default(cuid())
  resultId       String
  category       String
  riskPercentage Int
  riskLevel      RiskLevel
  displayOrder   Int
  result         ScreeningResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, category])
}

enum SchoolAvailabilityStatus {
  IMMEDIATE
  WAITLIST
  CLOSED
}

// School visibility / operational status (admin-controlled).
enum SchoolStatus {
  ACTIVE
  INACTIVE
}

// Enrollment lifecycle (supersedes the original ACTIVE/ENDED pair).
enum SchoolChildEnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
  GRADUATED
}

// Notification read-state.
enum SchoolNotificationStatus {
  UNREAD
  READ
}

model School {
  id                      String                   @id @default(cuid())
  name                    String
  city                    String
  address                 String
  description             String?                  @db.Text
  // Public contact / media
  email                   String?
  website                 String?                  @db.Text
  logoUrl                 String?                  @db.Text
  coverImageUrl           String?                  @db.Text
  // Profile detail
  studentTeacherRatio     String?
  availabilityStatus      SchoolAvailabilityStatus @default(IMMEDIATE)
  waitlistEstimate        String?
  admissionRequirements   String?                  @db.Text
  operatingHours          String?
  facilities              Json? // string[] of facility names
  specializations         Json? // string[] of specialization tags
  // Admin-controlled trust flag; NOT editable by the school account itself.
  isVerified              Boolean                  @default(false)
  // School-side features
  studentCapacity         Int                      @default(0)
  status                  SchoolStatus             @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  favorites               FavoriteSchool[]
  reviews                 Review[]
  admissionRequests       AdmissionRequest[]
  staff                   SchoolStaff[]
  childEnrollments        SchoolChildEnrollment[]
  activityReports         ActivityReport[]
  notifications           Notification[]
  reportAttachmentUploads ReportAttachmentUpload[]
  connectionCodes         SchoolConnectionCode[]
  subscriptions           Subscription[]
  sponsorships            Sponsorship[]

  @@index([city, name])
}

model SchoolStaff {
  id                  String                  @id @default(cuid())
  parentId            String
  schoolId            String
  // "ADMIN" manages the school, its staff and its connection codes; "TEACHER"
  // sees only the children assigned to them.
  role                String                  @default("TEACHER")
  title               String?
  // Set when the school admin removes the teacher; the account can no longer
  // sign in or reach school data.
  deactivatedAt       DateTime?
  createdAt           DateTime                @default(now())
  parent              Parent                  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  school              School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignedEnrollments SchoolChildEnrollment[]
  teaching            EnrollmentTeacher[]

  @@unique([parentId, schoolId])
  @@index([schoolId])
}

model SchoolChildEnrollment {
  id               String                      @id @default(cuid())
  schoolId         String
  childId          String
  leadSpecialistId String? // Optional: assigned lead specialist staff member
  status           SchoolChildEnrollmentStatus @default(PENDING)
  startDate        DateTime                    @default(now()) @map("started_at")
  endDate          DateTime?                   @map("ended_at")
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  school           School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  child            Child                       @relation(fields: [childId], references: [id], onDelete: Cascade)
  leadSpecialist   SchoolStaff?                @relation(fields: [leadSpecialistId], references: [id], onDelete: SetNull)
  teachers         EnrollmentTeacher[]
  connectionCodes  SchoolConnectionCode[]

  @@unique([schoolId, childId])
  @@index([childId, status])
  @@index([schoolId, status])
  @@index([leadSpecialistId])
}

/// A teacher assigned to a child's enrollment. A child can have several.
model EnrollmentTeacher {
  id           String                @id @default(cuid())
  enrollmentId String
  staffId      String
  createdAt    DateTime              @default(now())
  enrollment   SchoolChildEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  staff        SchoolStaff           @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, staffId])
  @@index([staffId])
}

/// A single-use code a school hands a family in person. The parent enters it,
/// picks one of their children and consents; that creates or reactivates the
/// enrollment. Only an HMAC of the code is stored.
model SchoolConnectionCode {
  id               String                 @id @default(cuid())
  schoolId         String
  codeHash         String                 @unique
  // A note for the school, e.g. the family's name. Shown to the parent too.
  label            String?
  // SchoolStaff ids to assign as teachers when the code is used.
  teacherStaffIds  Json?
  createdByStaffId String?
  expiresAt        DateTime
  usedAt           DateTime?
  usedByParentId   String?
  enrollmentId     String?
  revokedAt        DateTime?
  createdAt        DateTime               @default(now())
  school           School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment       SchoolChildEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
}

model SchoolRegistrationRequest {
  id               String                   @id @default(cuid())
  schoolName       String
  city             String
  address          String?
  contactFirstName String
  contactLastName  String
  contactTitle     String?
  email            String
  phone            String
  studentCount     Int?
  message          String?                  @db.Text
  status           SchoolRegistrationStatus @default(PENDING)
  rejectionReason  String?                  @db.Text
  reviewedById     String?
  reviewedAt       DateTime?
  schoolId         String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model HospitalRegistrationRequest {
  id               String                     @id @default(cuid())
  hospitalName     String
  city             String
  address          String?
  contactFirstName String
  contactLastName  String
  contactTitle     String?
  email            String
  phone            String
  services         String?                    @db.Text
  message          String?                    @db.Text
  status           HospitalRegistrationStatus @default(PENDING)
  rejectionReason  String?                    @db.Text
  reviewedById     String?
  reviewedAt       DateTime?
  hospitalId       String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model FavoriteSchool {
  id        String   @id @default(cuid())
  parentId  String
  schoolId  String
  createdAt DateTime @default(now())
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([parentId, schoolId])
}

model Review {
  id        String   @id @default(cuid())
  parentId  String
  schoolId  String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model AdmissionRequest {
  id        String                 @id @default(cuid())
  parentId  String
  schoolId  String
  childId   String?
  message   String?                @db.Text
  status    AdmissionRequestStatus @default(REQUESTED)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  parent    Parent                 @relation(fields: [parentId], references: [id], onDelete: Cascade)
  school    School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  child     Child?                 @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([parentId, createdAt])
  @@index([childId])
}

model Hospital {
  id           String          @id @default(cuid())
  name         String
  city         String
  address      String
  services     String          @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  doctors      Doctor[]
  appointments Appointment[]
  staff        HospitalStaff[]

  @@index([city, name])
}

model HospitalStaff {
  id            String    @id @default(cuid())
  parentId      String
  hospitalId    String
  role          String    @default("COORDINATOR")
  title         String?
  deactivatedAt DateTime?
  doctorId      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  parent        Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  hospital      Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctor        Doctor?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@unique([parentId, hospitalId])
  @@index([hospitalId])
}

model Doctor {
  id                  String         @id @default(cuid())
  hospitalId          String
  fullName            String
  specialty           String
  bio                 String?        @db.Text
  availableDays       String         @default("1,2,3,4,5")
  startHour           Int            @default(9)
  endHour             Int            @default(17)
  slotDurationMinutes Int            @default(30)
  timezone            String         @default("Asia/Phnom_Penh")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  hospital            Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  staffAccount        HospitalStaff?

  @@index([hospitalId])
}

model Appointment {
  id              String            @id @default(cuid())
  parentId        String
  childId         String?
  hospitalId      String
  doctorId        String?
  scheduledAt     DateTime
  status          AppointmentStatus @default(REQUESTED)
  // The parent's reason for requesting the appointment.
  reason          String?           @db.Text
  // The hospital's explanation when it rejects a request (status CANCELLED).
  // Distinct from `reason` above, which is the parent's own text.
  rejectionReason String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  parent          Parent            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child           Child?            @relation(fields: [childId], references: [id])
  hospital        Hospital          @relation(fields: [hospitalId], references: [id])
  doctor          Doctor?           @relation(fields: [doctorId], references: [id])

  @@index([doctorId, scheduledAt])
  @@index([parentId, scheduledAt])
  @@index([hospitalId, scheduledAt])
  @@index([doctorId, status, scheduledAt])
  @@index([hospitalId, status, scheduledAt])
}

model Activity {
  id           String             @id @default(cuid())
  title        String
  category     String
  minAgeMonths Int
  maxAgeMonths Int
  summary      String             @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  progress     ActivityProgress[]

  @@index([category, minAgeMonths, maxAgeMonths])
}

model ActivityProgress {
  id                String    @id @default(cuid())
  childId           String
  activityId        String
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  parentObservation String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  child             Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  activity          Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([childId, activityId])
}

model ActivityReport {
  id                 String                   @id @default(cuid())
  schoolId           String
  childId            String
  reporterId         String
  activityCategory   String
  title              String
  summary            String                   @db.Text
  activityDate       DateTime
  status             ActivityReportStatus     @default(DRAFT)
  duration           Int? // minutes
  performanceMetrics Json?
  teacherObservation String?                  @db.Text
  recommendations    String?                  @db.Text
  photoUrls          Json? // string[] of photo URLs
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  school             School                   @relation(fields: [schoolId], references: [id])
  child              Child                    @relation(fields: [childId], references: [id], onDelete: Cascade)
  reporter           Parent                   @relation(fields: [reporterId], references: [id])
  attachments        ReportAttachmentUpload[]

  @@index([childId, activityDate])
  @@index([schoolId, activityDate])
  @@index([childId, status, activityDate])
  @@index([schoolId, status, activityDate])
  @@index([reporterId])
  @@map("SchoolActivityReport")
}

model Notification {
  id            String                   @id @default(cuid())
  parentId      String
  schoolId      String?
  type          NotificationType
  status        SchoolNotificationStatus @default(UNREAD)
  title         String
  body          String
  enrollmentId  String?
  reportId      String?
  appointmentId String?
  createdAt     DateTime                 @default(now())
  parent        Parent                   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  school        School?                  @relation(fields: [schoolId], references: [id])

  @@index([parentId, status])
  @@index([schoolId])
  @@index([schoolId, status, createdAt])
  @@index([enrollmentId])
}

model AccountInvitation {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  role        UserRole
  parentId    String?
  schoolId    String?
  hospitalId  String?
  title       String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  parent      Parent?   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tokenHash])
}

model AuditEvent {
  id          String   @id @default(cuid())
  action      String
  actorId     String?
  actorRole   String?
  targetId    String?
  targetEmail String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([targetEmail])
  @@index([createdAt])
}

model ReportAttachmentUpload {
  id          String          @id @default(cuid())
  schoolId    String
  reporterId  String
  filename    String          @unique
  storageKey  String
  contentType String
  byteSize    Int
  reportId    String?
  createdAt   DateTime        @default(now())
  expiresAt   DateTime
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reporter    Parent          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  report      ActivityReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([expiresAt, reportId])
  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Caregiver update.
//
// Four things live here: what a parent recorded happening day to day, what they
// asked the assistant and what it answered, what the app noticed across those
// records, and the reviewed material that guidance may be drawn from.
//
// Safety note encoded in the shape of these tables: there is no column anywhere
// for a diagnosis, a severity verdict or a medication. An observation stores what
// a caregiver saw, an insight stores a pattern in those observations, and every
// assistant turn stores the sources it was allowed to use.
// ---------------------------------------------------------------------------

model BehaviorObservation {
  id         String              @id @default(cuid())
  childId    String
  // Denormalised owner so a parent-scoped query never needs a join, and so
  // deleting a parent's account removes their records even if a child row were
  // somehow orphaned.
  parentId   String
  category   ObservationCategory
  // 1 (mild) to 5 (severe) — the parent's own read, not a clinical scale.
  intensity  Int
  occurredAt DateTime
  note       String?             @db.Text
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  child      Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent     Parent              @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([childId, occurredAt])
  @@index([parentId, occurredAt])
  @@index([childId, category, occurredAt])
}

model AiConversation {
  id        String      @id @default(cuid())
  parentId  String
  // Optional: a parent can ask a general question before choosing a child.
  childId   String?
  title     String
  // BCP-47-ish tag ('en' | 'km'). Answers are generated natively in this
  // language rather than translated afterwards.
  language  String      @default("en")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  parent    Parent      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child     Child?      @relation(fields: [childId], references: [id], onDelete: SetNull)
  messages  AiMessage[]

  @@index([parentId, updatedAt])
  @@index([childId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AiMessageRole
  kind           AiMessageKind  @default(ANSWER)
  content        String         @db.Text
  // Provenance for assistant turns: which model produced the answer, how long it
  // took, and which reviewed sources it was permitted to draw on. Stored so an
  // answer can be audited later without re-running the model.
  model          String?
  latencyMs      Int?
  tokensIn       Int?
  tokensOut      Int?
  sources        Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// A cached read over a window of observations. Cached because the dashboard must
// not call a model on every page view, and because a pattern shown to a parent
// should be the same pattern they saw yesterday until the data changes.
model AiInsight {
  id              String   @id @default(cuid())
  childId         String
  windowStart     DateTime
  windowEnd       DateTime
  summary         String   @db.Text
  // Structured counts behind the summary, so the UI can render bars without
  // reparsing prose, and so a reviewer can see the evidence for a claim.
  patterns        Json
  analysisVersion String
  // Null when the summary was produced without a model (deterministic fallback).
  model           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, windowStart, windowEnd])
  @@index([childId, windowEnd])
}

// Reviewed source material. Nothing is generated into these tables: they are
// populated from files the project owner has approved, with the publisher,
// licence and link recorded so every suggestion can cite where it came from.
model KnowledgeDocument {
  id         String           @id @default(cuid())
  title      String
  publisher  String
  sourceUrl  String           @unique @db.VarChar(512)
  licence    String
  language   String           @default("en")
  version    String
  // When a human last checked the material against the source. Null means it
  // has been imported but not reviewed, and therefore cannot be cited.
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  chunks     KnowledgeChunk[]

  @@index([language, reviewedAt])
}

model KnowledgeChunk {
  id           String            @id @default(cuid())
  documentId   String
  displayOrder Int
  heading      String?
  content      String            @db.Text
  // Retrieval keywords. Derived from `content` at import time, so it is stored
  // as a JSON array rather than a table of its own.
  keywords     Json
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, displayOrder])
}

// ---------------------------------------------------------------------------
// Subscriptions. PRO belongs to a parent, BUSINESS to a school; "Free" is simply
// having no subscription that currently grants access. Until a payment provider
// is chosen, the platform admin records subscriptions by hand (provider MANUAL).
// Nothing here is deleted when a plan ends: rows move to CANCELED or EXPIRED and
// every child record stays where it is.
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  PRO
  BUSINESS
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Subscription {
  id                String             @id @default(cuid())
  plan              SubscriptionPlan
  interval          BillingInterval
  status            SubscriptionStatus @default(ACTIVE)
  // Exactly one owner: parentId for PRO, schoolId for BUSINESS.
  parentId          String?
  schoolId          String?
  // Price recorded when the plan was set, in cents.
  priceCents        Int
  currency          String             @default("USD")
  startedAt         DateTime           @default(now())
  // Paid-through date. A CANCELED plan keeps access until then.
  currentPeriodEnd  DateTime?
  canceledAt        DateTime?
  provider          String             @default("MANUAL")
  providerReference String?
  note              String?            @db.Text
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  parent            Parent?            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  school            School?            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sponsorships      Sponsorship[]

  @@index([parentId, status])
  @@index([schoolId, status])
}

enum SponsorshipStatus {
  INVITED
  ACTIVE
  ENDED
}

// One of the five sponsored Pro family accounts a Business school includes. The
// school pays; the parent keeps their own login and their own data. A
// sponsorship never gives the school access to any child record.
model Sponsorship {
  id             String            @id @default(cuid())
  schoolId       String
  subscriptionId String
  email          String
  parentId       String?
  status         SponsorshipStatus @default(INVITED)
  // Set while the slot is open (INVITED or ACTIVE) and cleared when it ends, so
  // the unique indexes stop a school inviting the same email twice and stop one
  // parent holding two live sponsorships. MySQL allows many NULLs in a unique index.
  openKey        String?           @unique
  activeParentId String?           @unique
  invitedById    String
  invitedAt      DateTime          @default(now())
  acceptedAt     DateTime?
  endedAt        DateTime?
  endedReason    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  parent         Parent?           @relation(fields: [parentId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([email, status])
}
